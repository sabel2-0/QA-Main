@{
    ViewData["Title"] = "Resolved Tickets Awaiting QA";
    Layout = "~/Views/Shared/_QALayout.cshtml";
    var ratedTickets = 10;
    var totalTickets = 50;
}

@section Styles {
<style>
    .page-wrap {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-radius: 14px;
        padding: 16px;
    }

    .head {
        display: grid;
        gap: 10px;
        margin-bottom: 12px;
    }

    .head h2 {
        font-size: 1.3rem;
        margin: 0;
    }

    .head-sub {
        color: #666666;
        font-size: .85rem;
    }

    .progress-sub {
        font-size: .82rem;
        font-weight: 600;
        color: #333333;
        background: #f3f3f3;
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-radius: 999px;
        padding: 6px 10px;
        width: fit-content;
    }

    .filters {
        display: grid;
        gap: 8px;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 8px;
    }

    .filter-input,
    .filter-select {
        width: 100%;
        border: 1px solid rgba(0, 0, 0, 0.18);
        border-radius: 10px;
        padding: 8px 10px;
        font-size: .82rem;
        background: #ffffff;
        color: #222222;
    }

    .search-wrap {
        position: relative;
    }

    .search-wrap i {
        position: absolute;
        left: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: #777777;
        font-size: .85rem;
    }

    .search {
        width: 100%;
        border: 1px solid rgba(0, 0, 0, 0.18);
        border-radius: 10px;
        padding: 9px 12px 9px 30px;
        font-size: .86rem;
        background: #ffffff;
    }

    .btn {
        text-decoration: none;
        border-radius: 10px;
        padding: 8px 12px;
        background: #111111;
        color: #ffffff;
        font-weight: 600;
        font-size: .82rem;
    }

    .tickets {
        display: grid;
        gap: 10px;
    }

    .ticket {
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 12px;
        padding: 12px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
        align-items: center;
        background: #f7f7f7;
    }

    .name { font-weight: 700; color: #111111; }
    .sub { color: #666666; }

    .empty-state {
        display: none;
        border: 1px dashed rgba(0, 0, 0, 0.2);
        border-radius: 12px;
        padding: 14px;
        color: #555555;
        background: #fafafa;
        font-size: .86rem;
    }

    @@media (max-width: 700px) {
        .filter-grid {
            grid-template-columns: 1fr 1fr;
        }

        .ticket {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 520px) {
        .filter-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
}

<section class="page-wrap">
    <div class="head">
        <h2>Resolved tickets awaiting QA</h2>
        <div class="head-sub">Clarification: this list means resolved tickets that still need QA review and rating.</div>
        <div class="progress-sub">@ratedTickets tickets rated out of @totalTickets</div>
        <div class="filters">
            <div class="filter-grid">
                <select id="quick-range" class="filter-select">
                    <option id="custom-range-option" value="custom">Custom range</option>
                    <option value="today">Today</option>
                    <option value="last7">Last 7 days</option>
                    <option value="last30">Last 30 days</option>
                </select>
                <input id="from-date" class="filter-input" type="date" />
                <input id="to-date" class="filter-input" type="date" />
            </div>
            <div class="search-wrap">
                <i class="bi bi-search"></i>
                <input id="ticket-search" class="search" type="text" placeholder="Search by ticket number, customer, or date..." />
            </div>
        </div>
    </div>

    <div class="tickets" id="ticket-list">
        <div class="ticket" data-agent="alyson cruz" data-date="2026-04-14" data-search="10291 agent alyson cruz customer mark reyes apr 14 2026 1009 am waiting qa rating">
            <div><div class="name">Ticket #10291 - Agent: Alyson Cruz · Customer: Mark Reyes</div><div class="sub">Resolved Apr 14, 2026 10:09 AM, waiting QA rating</div></div><a class="btn" href="/QA/Rating/10291">Rate</a>
        </div>
        <div class="ticket" data-agent="miguel dela rosa" data-date="2026-04-14" data-search="10290 agent miguel dela rosa customer nina alvarez apr 14 2026 0934 am waiting qa rating">
            <div><div class="name">Ticket #10290 - Agent: Miguel Dela Rosa · Customer: Nina Alvarez</div><div class="sub">Resolved Apr 14, 2026 09:34 AM, waiting QA rating</div></div><a class="btn" href="/QA/Rating/10290">Rate</a>
        </div>
        <div class="ticket" data-agent="jenny tan" data-date="2026-04-14" data-search="10288 agent jenny tan customer carlo santos apr 14 2026 0758 am waiting qa rating">
            <div><div class="name">Ticket #10288 - Agent: Jenny Tan · Customer: Carlo Santos</div><div class="sub">Resolved Apr 14, 2026 07:58 AM, waiting QA rating</div></div><a class="btn" href="/QA/Rating/10288">Rate</a>
        </div>
        <div class="ticket" data-agent="arvin santos" data-date="2026-04-13" data-search="10283 agent arvin santos customer paolo rivera apr 13 2026 0541 pm waiting qa rating">
            <div><div class="name">Ticket #10283 - Agent: Arvin Santos · Customer: Paolo Rivera</div><div class="sub">Resolved Apr 13, 2026 05:41 PM, waiting QA rating</div></div><a class="btn" href="/QA/Rating/10283">Rate</a>
        </div>
        <div class="ticket" data-agent="celine ong" data-date="2026-04-13" data-search="10280 agent celine ong customer trisha cruz apr 13 2026 0315 pm waiting qa rating">
            <div><div class="name">Ticket #10280 - Agent: Celine Ong · Customer: Trisha Cruz</div><div class="sub">Resolved Apr 13, 2026 03:15 PM, waiting QA rating</div></div><a class="btn" href="/QA/Rating/10280">Rate</a>
        </div>
    </div>
    <div id="ticket-empty" class="empty-state">No tickets found for the selected filters.</div>
</section>

<script>
    (function () {
        var input = document.getElementById('ticket-search');
        var quickRange = document.getElementById('quick-range');
        var customRangeOption = document.getElementById('custom-range-option');
        var fromDate = document.getElementById('from-date');
        var toDate = document.getElementById('to-date');
        var list = document.getElementById('ticket-list');
        var emptyState = document.getElementById('ticket-empty');
        if (!input || !list || !quickRange || !customRangeOption || !fromDate || !toDate || !emptyState) return;

        var rows = list.querySelectorAll('.ticket');

        function toIsoDate(d) {
            var y = d.getFullYear();
            var m = String(d.getMonth() + 1).padStart(2, '0');
            var day = String(d.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + day;
        }

        function applyQuickRange() {
            var now = new Date();
            var selected = quickRange.value;
            if (!selected || selected === 'custom') return;

            var end = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            var start = new Date(end);
            if (selected === 'today') start = end;
            else if (selected === 'last7') start.setDate(start.getDate() - 6);
            else if (selected === 'last30') start.setDate(start.getDate() - 29);

            fromDate.value = toIsoDate(start);
            toDate.value = toIsoDate(end);
        }

        function applyFilters() {
            var q = (input.value || '').toLowerCase().trim();
            var fromVal = fromDate.value || '';
            var toVal = toDate.value || '';
            var visibleCount = 0;

            rows.forEach(function (row) {
                var haystack = (row.getAttribute('data-search') || '').toLowerCase();
                var rowDate = row.getAttribute('data-date') || '';

                var matchSearch = !q || haystack.indexOf(q) !== -1;
                var matchDateFrom = !fromVal || (rowDate && rowDate >= fromVal);
                var matchDateTo = !toVal || (rowDate && rowDate <= toVal);

                var isVisible = matchSearch && matchDateFrom && matchDateTo;
                row.style.display = isVisible ? '' : 'none';
                if (isVisible) visibleCount++;
            });

            emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        function setCustomRangeOnManualDate() {
            quickRange.value = 'custom';
        }

        input.addEventListener('input', applyFilters);
        fromDate.addEventListener('change', function () {
            setCustomRangeOnManualDate();
            applyFilters();
        });
        toDate.addEventListener('change', function () {
            setCustomRangeOnManualDate();
            applyFilters();
        });
        fromDate.addEventListener('focus', setCustomRangeOnManualDate);
        toDate.addEventListener('focus', setCustomRangeOnManualDate);
        fromDate.addEventListener('click', setCustomRangeOnManualDate);
        toDate.addEventListener('click', setCustomRangeOnManualDate);
        quickRange.addEventListener('change', function () {
            if (quickRange.value === 'custom') {
                fromDate.value = '';
                toDate.value = '';
            }
            applyQuickRange();
            applyFilters();
        });

        applyFilters();
    })();
</script>
