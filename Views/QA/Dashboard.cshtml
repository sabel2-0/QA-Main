                ratedTrend: [2, 2, 2, 2, 2, 3, 3, 3, 2, 2, 3, 3, 4, 3, 3, 2, 2, 3, 4, 4, 4, 3, 3, 4, 5, 4, 4, 3, 3, 2],
                topAgents: [
                    { name: 'Jenny Tan', resolvedText: 'Resolved 34 tickets this week', score: '4.6 / 5' },
                    { name: 'Alyson Cruz', resolvedText: 'Resolved 33 tickets this week', score: '4.5 / 5' },
                    { name: 'Miguel Dela Rosa', resolvedText: 'Resolved 32 tickets this week', score: '4.5 / 5' },
                    { name: 'Ramon Lee', resolvedText: 'Resolved 30 tickets this week', score: '4.4 / 5' },
                    { name: 'Celine Ong', resolvedText: 'Resolved 27 tickets this week', score: '4.4 / 5' }
                ],
                awaitingTickets: [
                    { id: 10271, agent: 'Alyson Cruz', customer: 'Mark Reyes', resolvedAt: 'Apr 12, 2026 10:03 AM' },
                    { id: 10266, agent: 'Miguel Dela Rosa', customer: 'Nina Alvarez', resolvedAt: 'Apr 12, 2026 08:17 AM' },
                    { id: 10264, agent: 'Jenny Tan', customer: 'Aris Gomez', resolvedAt: 'Apr 12, 2026 07:46 AM' },
                    { id: 10259, agent: 'Ramon Lee', customer: 'Diane Cruz', resolvedAt: 'Apr 12, 2026 06:31 AM' }
                ]
            }
        };

        function renderAgents(items) {
            if (!agentList) return;
            var html = '';
            for (var i = 0; i < items.length; i++) {
                html += '<div class="agent-item">';
                html += '<div class="agent-left">';
                html += '<span class="rank-pill">' + (i + 1) + '</span>';
                html += '<div><div class="agent-name">' + items[i].name + '</div>';
                html += '<div class="agent-sub">' + items[i].resolvedText + '</div></div>';
                html += '</div>';
                html += '<span class="score-pill">' + items[i].score + '</span>';
                html += '</div>';
            }
            agentList.innerHTML = html;
        }

        function renderTickets(items) {
            if (!ticketList) return;
            var html = '';
            for (var i = 0; i < items.length; i++) {
                var t = items[i];
                html += '<div class="ticket-item">';
                html += '<div>';
                html += '<div class="ticket-id">Ticket #' + t.id + ' · Agent: ' + t.agent + ' · Customer: ' + t.customer + '</div>';
                html += '<div class="ticket-sub">Resolved ' + t.resolvedAt + ' — awaiting QA rating</div>';
                html += '</div>';
                html += '<a class="ticket-btn" href="/QA/Rating/' + t.id + '">Rate</a>';
                html += '</div>';
            }
            ticketList.innerHTML = html;
        }

        function renderTrend(resolved, rated) {
            if (!svg) return;
            svg.innerHTML = '';

            var totalDays = resolved.length;
            var w = 960;
            var h = 260;
            var pLeft = 42;
            var pRight = 14;
            var pTop = 14;
            var pBottom = 30;
            var chartW = w - pLeft - pRight;
            var chartH = h - pTop - pBottom;
            var maxY = Math.max.apply(null, resolved.concat([1]));
            var ySteps = 5;
            var ns = 'http://www.w3.org/2000/svg';

            function xAt(i) {
                if (totalDays <= 1) return pLeft;
                return pLeft + (i * chartW / (totalDays - 1));
            }

            function yAt(val) {
                return pTop + ((maxY - val) / maxY) * chartH;
            }

            function linePath(values) {
                var d = '';
                for (var i = 0; i < values.length; i++) {
                    var x = xAt(i);
                    var y = yAt(values[i]);
                    d += (i === 0 ? 'M ' : ' L ') + x.toFixed(2) + ' ' + y.toFixed(2);
                }
                return d;
            }

            function addNode(node) {
                svg.appendChild(node);
            }

            for (var s = 0; s <= ySteps; s++) {
                var yVal = Math.round((maxY / ySteps) * s);
                var y = yAt(yVal);

                var grid = document.createElementNS(ns, 'line');
                grid.setAttribute('x1', pLeft);
                grid.setAttribute('x2', w - pRight);
                grid.setAttribute('y1', y);
                grid.setAttribute('y2', y);
                grid.setAttribute('stroke', '#d9d9d9');
                grid.setAttribute('stroke-width', '1');
                addNode(grid);

                var label = document.createElementNS(ns, 'text');
                label.setAttribute('x', pLeft - 8);
                label.setAttribute('y', y + 4);
                label.setAttribute('text-anchor', 'end');
                label.setAttribute('font-size', '10');
                label.setAttribute('fill', '#666');
                label.textContent = String(yVal);
                addNode(label);
            }

            for (var d = 0; d < totalDays; d++) {
                if ((d + 1) % 5 !== 0 && d !== 0 && d !== totalDays - 1) continue;
                var tx = xAt(d);
                var dayLabel = document.createElementNS(ns, 'text');
                dayLabel.setAttribute('x', tx);
                dayLabel.setAttribute('y', h - 10);
                dayLabel.setAttribute('text-anchor', 'middle');
                dayLabel.setAttribute('font-size', '10');
                dayLabel.setAttribute('fill', '#666');
                dayLabel.textContent = String(d + 1);
                addNode(dayLabel);
            }

            var resolvedPath = document.createElementNS(ns, 'path');
            resolvedPath.setAttribute('d', linePath(resolved));
            resolvedPath.setAttribute('fill', 'none');
            resolvedPath.setAttribute('stroke', '#111111');
            resolvedPath.setAttribute('stroke-width', '2.4');
            addNode(resolvedPath);

            var ratedPath = document.createElementNS(ns, 'path');
            ratedPath.setAttribute('d', linePath(rated));
            ratedPath.setAttribute('fill', 'none');
            ratedPath.setAttribute('stroke', '#3f7cff');
            ratedPath.setAttribute('stroke-width', '2.4');
            addNode(ratedPath);

            function addMarkers(values, color) {
                for (var i = 0; i < values.length; i++) {
                    if ((i + 1) % 5 !== 0 && i !== totalDays - 1) continue;
                    var dot = document.createElementNS(ns, 'circle');
                    dot.setAttribute('cx', xAt(i));
                    dot.setAttribute('cy', yAt(values[i]));
                    dot.setAttribute('r', '2.5');
                    dot.setAttribute('fill', color);
                    addNode(dot);
                }
            }

            addMarkers(resolved, '#111111');
            addMarkers(rated, '#3f7cff');

            var peakValue = -1;
            var peakDay = 1;
            var quietValue = 9999;
            var quietDay = 1;
            for (var i = 0; i < resolved.length; i++) {
                if (resolved[i] > peakValue) {
                    peakValue = resolved[i];
                    peakDay = i + 1;
                }
                if (resolved[i] < quietValue) {
                    quietValue = resolved[i];
                    quietDay = i + 1;
                }
            }

            if (peakNode) peakNode.textContent = 'Peak day: Day ' + peakDay + ' (' + peakValue + ' resolved)';
            if (quietNode) quietNode.textContent = 'Quiet day: Day ' + quietDay + ' (' + quietValue + ' resolved)';
        }

        function parseIsoDate(dateKey) {
            if (!dateKey || !/^\d{4}-\d{2}-\d{2}$/.test(dateKey)) return null;
            var parts = dateKey.split('-');
            var y = parseInt(parts[0], 10);
            var m = parseInt(parts[1], 10) - 1;
            var d = parseInt(parts[2], 10);
            return new Date(y, m, d);
        }

        function formatLabelFromIso(dateKey) {
            var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            var dt = parseIsoDate(dateKey);
            if (!dt) return 'Apr 14, 2026';
            return months[dt.getMonth()] + ' ' + dt.getDate() + ', ' + dt.getFullYear();
        }

        function clamp(value, min, max) {
            return Math.max(min, Math.min(max, value));
        }

        function buildSyntheticSample(dateKey) {
            var base = dashboardSamples['2026-04-14'];
            var baseDate = parseIsoDate('2026-04-14');
            var targetDate = parseIsoDate(dateKey);
            if (!base || !baseDate || !targetDate) return base;

            var dayOffset = Math.round((targetDate.getTime() - baseDate.getTime()) / 86400000);
            var drift = (dayOffset % 7) - 3;

            var resolvedTrend = [];
            var ratedTrend = [];
            for (var i = 0; i < base.resolvedTrend.length; i++) {
                var resolvedVal = clamp(base.resolvedTrend[i] + drift + ((i % 5 === 0) ? 1 : 0), 5, 30);
                var ratedRatio = clamp(0.26 + (dayOffset * 0.01), 0.14, 0.42);
                var ratedVal = clamp(Math.round(resolvedVal * ratedRatio), 1, resolvedVal);
                resolvedTrend.push(resolvedVal);
                ratedTrend.push(ratedVal);
            }

            var resolvedTotal = resolvedTrend.reduce(function (sum, n) { return sum + n; }, 0);
            var ratedTotal = ratedTrend.reduce(function (sum, n) { return sum + n; }, 0);
            var coverage = resolvedTotal <= 0 ? 0 : Math.round((ratedTotal / resolvedTotal) * 1000) / 10;
            var pending = Math.max(0, resolvedTotal - ratedTotal);
            var avgScore = clamp(4.7 + (dayOffset * 0.02), 4.0, 4.9);
            var agentMetric = clamp(91.8 + (dayOffset * 0.6), 84.0, 97.5);
            var updatedCount = Math.max(1, 3 + (dayOffset % 4));
            var unclosed = clamp(12 + (dayOffset * 2), 5, 42);

            var label = formatLabelFromIso(dateKey);
            var topAgents = base.topAgents.map(function (item, idx) {
                var match = (item.resolvedText || '').match(/(\d+)/);
                var count = match ? parseInt(match[1], 10) : 30;
                var newCount = Math.max(8, count + dayOffset - idx);
                var newScore = clamp(parseFloat(item.score) + (dayOffset * 0.01), 4.0, 5.0).toFixed(1);
                return {
                    name: item.name,
                    resolvedText: 'Resolved ' + newCount + ' tickets this week',
                    score: newScore + ' / 5'
                };
            });

            var awaitingTickets = base.awaitingTickets.map(function (ticket, idx) {
                var timeMatch = (ticket.resolvedAt || '').match(/\d{1,2}:\d{2}\s(?:AM|PM)/);
                var timePart = timeMatch ? timeMatch[0] : '09:00 AM';
                return {
                    id: ticket.id + (dayOffset * 3) - idx,
                    agent: ticket.agent,
                    customer: ticket.customer,
                    resolvedAt: label + ' ' + timePart
                };
            });

            return {
                label: label,
                agentMetric: agentMetric.toFixed(1) + '%',
                unclosedResolved: String(Math.round(unclosed)),
                ticketsRated: ratedTotal + ' / ' + resolvedTotal,
                ticketsRatedSub: coverage.toFixed(1) + '% QA completion coverage',
                pendingRatings: String(pending),
                averageQaScore: avgScore.toFixed(1) + ' / 5',
                ratingsUpdated: String(updatedCount),
                throughputNote: 'Prototype estimate for ' + label + '. QA coverage is at ' + coverage.toFixed(1) + '%; continue rating oldest unresolved items first.',
                throughputPercent: clamp(Math.round(coverage), 5, 95),
                qualityNote: 'Prototype estimate: monitor tickets below ' + Math.max(3.9, avgScore - 0.5).toFixed(1) + '/5 and schedule calibration if trend dips.',
                resolvedTrend: resolvedTrend,
                ratedTrend: ratedTrend,
                topAgents: topAgents,
                awaitingTickets: awaitingTickets
            };
        }

        function applyDashboardDate(dateKey) {
            var sample = dashboardSamples[dateKey] || buildSyntheticSample(dateKey);
            var isPresetSample = !!dashboardSamples[dateKey];

            if (metricAgentQuality) metricAgentQuality.textContent = sample.agentMetric;
            if (metricUnclosed) metricUnclosed.textContent = sample.unclosedResolved;
            if (insightRated) insightRated.textContent = sample.ticketsRated;
            if (insightRatedSub) insightRatedSub.textContent = sample.ticketsRatedSub;
            if (insightPending) insightPending.textContent = sample.pendingRatings;
            if (insightPendingSub) insightPendingSub.textContent = 'Backlog from resolved queue';
            if (insightAverage) insightAverage.textContent = sample.averageQaScore;
            if (insightUpdated) insightUpdated.textContent = sample.ratingsUpdated;
            if (throughputNote) throughputNote.textContent = sample.throughputNote;
            if (throughputProgress) throughputProgress.style.width = sample.throughputPercent + '%';
            if (qualityNote) qualityNote.textContent = sample.qualityNote;
            if (dateContext) dateContext.textContent = 'Showing data for ' + sample.label + '.';

            renderAgents(sample.topAgents);
            renderTickets(sample.awaitingTickets);
            renderTrend(sample.resolvedTrend, sample.ratedTrend);
        }

        if (dateOpenBtn) {
            dateOpenBtn.addEventListener('click', function () {
                if (typeof dateInput.showPicker === 'function') {
                    dateInput.showPicker();
                    return;
                }
                dateInput.focus();
                dateInput.click();
            });
        }

        dateInput.addEventListener('change', function () {
            applyDashboardDate(dateInput.value);
        });

        applyDashboardDate(dateInput.value || '2026-04-14');
    })();
</script>