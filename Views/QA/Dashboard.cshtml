@{
    ViewData["Title"] = "QA Dashboard";
    Layout = "~/Views/Shared/_QALayout.cshtml";
}

@section Styles {
<style>
    .qa-page {
        display: grid;
        gap: 16px;
        animation: qaFade .35s ease;
    }

    @@keyframes qaFade {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .hero {
        background: #111111;
        border-radius: 16px;
        color: #ffffff;
        padding: 28px 24px;
    }

    .hero-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

    .hero-copy {
        max-width: 760px;
    }

    .date-filter {
        min-width: 230px;
        background: rgba(255, 255, 255, 0.07);
        border: 0.5px solid rgba(255, 255, 255, 0.25);
        border-radius: 10px;
        padding: 10px 12px;
        display: grid;
        gap: 6px;
    }

    .date-filter label {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .03em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.9);
    }

    .date-filter input {
        width: 100%;
        border-radius: 8px;
        border: 0.5px solid rgba(255, 255, 255, 0.4);
        background: rgba(0, 0, 0, 0.35);
        color: #ffffff;
        padding: 7px 9px;
        font-size: .8rem;
    }

    .date-input-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 6px;
    }

    .date-open-btn {
        border-radius: 8px;
        border: 0.5px solid rgba(255, 255, 255, 0.4);
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
        font-size: .75rem;
        font-weight: 600;
        padding: 7px 10px;
        cursor: pointer;
    }

    .date-open-btn:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    .date-context {
        font-size: .72rem;
        color: rgba(255, 255, 255, 0.75);
        line-height: 1.35;
    }

    .hero h1 {
        font-size: clamp(1.3rem, 2vw, 1.7rem);
        font-weight: 500;
        margin: 0 0 6px;
        color: #ffffff;
    }

    .hero p {
        color: rgba(255, 255, 255, 0.6);
        font-size: .875rem;
        margin: 0;
        line-height: 1.6;
    }

    .metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 10px;
    }

    .insights-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(140px, 1fr));
        gap: 10px;
    }

    .insight-card {
        background: #ffffff;
        border: 0.5px solid rgba(0, 0, 0, 0.12);
        border-radius: 12px;
        padding: 14px;
    }

    .insight-label {
        font-size: .76rem;
        color: #666666;
        margin-bottom: 8px;
    }

    .insight-value {
        font-size: 1.35rem;
        font-weight: 600;
        color: #111111;
        line-height: 1;
        margin-bottom: 6px;
    }

    .insight-sub {
        font-size: .74rem;
        color: #666666;
        line-height: 1.4;
    }

    .insight-panel {
        background: #ffffff;
        border: 0.5px solid rgba(0, 0, 0, 0.12);
        border-radius: 12px;
        padding: 14px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .panel-block {
        background: #f7f7f7;
        border: 0.5px solid rgba(0, 0, 0, 0.1);
        border-radius: 10px;
        padding: 12px;
        display: grid;
        gap: 8px;
    }

    .panel-title {
        font-size: .82rem;
        font-weight: 600;
        color: #111111;
    }

    .progress-track {
        width: 100%;
        height: 8px;
        border-radius: 999px;
        background: #e2e2e2;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        width: 20%;
        background: #111111;
        border-radius: 999px;
    }

    .mini-note {
        font-size: .74rem;
        color: #666666;
        line-height: 1.45;
    }

    .insight-link {
        text-decoration: none;
        color: #111111;
        font-size: .75rem;
        font-weight: 600;
        background: #ededed;
        border: 0.5px solid rgba(0, 0, 0, 0.16);
        border-radius: 8px;
        padding: 6px 10px;
        width: fit-content;
    }

    .insight-link:hover {
        background: #111111;
        color: #ffffff;
    }

    .metric-card {
        background: #ffffff;
        border: 0.5px solid rgba(0, 0, 0, 0.12);
        border-radius: 12px;
        padding: 16px;
    }

    .metric-label {
        font-size: .78rem;
        color: #666666;
        margin-bottom: 8px;
    }

    .metric-value {
        font-size: 1.9rem;
        font-weight: 500;
        color: #111111;
        line-height: 1;
    }

    .boards {
        display: grid;
        grid-template-columns: 1.1fr .9fr;
        gap: 14px;
    }

    .trend-card {
        display: grid;
        gap: 12px;
    }

    .trend-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
    }

    .trend-title {
        font-size: .92rem;
        font-weight: 600;
        color: #111111;
        margin: 0;
    }

    .trend-sub {
        font-size: .76rem;
        color: #666666;
        margin-top: 4px;
    }

    .trend-legend {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .75rem;
        color: #444444;
        background: #f5f5f5;
        border: 0.5px solid rgba(0, 0, 0, 0.12);
        border-radius: 999px;
        padding: 4px 8px;
    }

    .legend-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        display: inline-block;
    }

    .legend-dot.resolved {
        background: #111111;
    }

    .legend-dot.rated {
        background: #3f7cff;
    }

    .trend-wrap {
        background: #fafafa;
        border: 0.5px solid rgba(0, 0, 0, 0.12);
        border-radius: 12px;
        padding: 8px;
    }

    .trend-svg {
        width: 100%;
        height: 260px;
        display: block;
    }

    .trend-note-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .trend-note {
        font-size: .75rem;
        color: #444444;
        background: #f5f5f5;
        border: 0.5px solid rgba(0, 0, 0, 0.12);
        border-radius: 999px;
        padding: 5px 9px;
    }

    .card {
        background: #ffffff;
        border-radius: 12px;
        border: 0.5px solid rgba(0, 0, 0, 0.12);
        padding: 16px;
    }

    .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 14px;
    }

    .card-head h3 {
        font-size: .9rem;
        font-weight: 500;
        color: #111111;
        margin: 0;
    }

    .card-link {
        text-decoration: none;
        font-size: .75rem;
        font-weight: 500;
        color: #555555;
        background: #f2f2f2;
        border: 0.5px solid rgba(0, 0, 0, 0.12);
        border-radius: 8px;
        padding: 5px 10px;
        transition: background .15s, color .15s;
    }

    .card-link:hover {
        background: #111111;
        color: #ffffff;
    }

    .agent-list,
    .ticket-list {
        display: grid;
        gap: 8px;
    }

    .agent-item,
    .ticket-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 11px 12px;
        border-radius: 8px;
        background: #f7f7f7;
        border: 0.5px solid rgba(0, 0, 0, 0.1);
    }

    .agent-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .rank-pill {
        min-width: 28px;
        height: 28px;
        border-radius: 999px;
        border: 0.5px solid rgba(0, 0, 0, 0.18);
        background: #ffffff;
        font-size: .76rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .agent-name,
    .ticket-id {
        font-size: .85rem;
        font-weight: 500;
        color: #111111;
        margin-bottom: 2px;
    }

    .agent-sub,
    .ticket-sub {
        font-size: .76rem;
        color: #666666;
    }

    .score-pill {
        font-size: .76rem;
        font-weight: 500;
        color: #111111;
        background: #ffffff;
        border: 0.5px solid rgba(0, 0, 0, 0.2);
        border-radius: 999px;
        padding: 4px 10px;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .ticket-btn {
        text-decoration: none;
        font-size: .76rem;
        font-weight: 500;
        color: #ffffff;
        background: #111111;
        border-radius: 8px;
        padding: 7px 11px;
        white-space: nowrap;
        flex-shrink: 0;
        transition: background .15s;
    }

    .ticket-btn:hover {
        background: #333333;
    }

    @@media (max-width: 900px) {
        .insights-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .insight-panel {
            grid-template-columns: 1fr;
        }

        .boards {
            grid-template-columns: 1fr;
        }

        .date-filter {
            min-width: 100%;
        }
    }

    @@media (max-width: 560px) {
        .insights-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
}

<section class="qa-page">
    <section class="hero">
        <div class="hero-top">
            <div class="hero-copy">
                <h1>QA Dashboard</h1>
                <p>Track agent quality, review resolved conversations, and send feedback ratings to improve response quality.</p>
            </div>
            <div class="date-filter">
                <label for="dashboard-date-filter">Dashboard date</label>
                <div class="date-input-row">
                    <input id="dashboard-date-filter" type="date" value="2026-04-14" />
                    <button id="dashboard-date-open" class="date-open-btn" type="button">Pick date</button>
                </div>
                <div id="dashboard-date-context" class="date-context">Showing data for Apr 14, 2026.</div>
            </div>
        </div>
    </section>

    <section class="metrics">
        <article class="metric-card">
            <div class="metric-label">Agent metrics</div>
            <div id="metric-agent-quality" class="metric-value">91.8%</div>
        </article>
        <article class="metric-card">
            <div class="metric-label">Unclosed resolved tickets</div>
            <div id="metric-unclosed" class="metric-value">12</div>
        </article>
    </section>

    <section class="insights-grid">
        <article class="insight-card">
            <div class="insight-label">Tickets rated</div>
            <div id="insight-rated" class="insight-value">10 / 50</div>
            <div id="insight-rated-sub" class="insight-sub">20% QA completion coverage</div>
        </article>
        <article class="insight-card">
            <div class="insight-label">Pending QA ratings</div>
            <div id="insight-pending" class="insight-value">40</div>
            <div id="insight-pending-sub" class="insight-sub">Backlog from resolved queue</div>
        </article>
        <article class="insight-card">
            <div class="insight-label">Average QA score</div>
            <div id="insight-average" class="insight-value">4.7 / 5</div>
            <div class="insight-sub">Across rated conversations</div>
        </article>
        <article class="insight-card">
            <div class="insight-label">Ratings updated</div>
            <div id="insight-updated" class="insight-value">3</div>
            <div class="insight-sub">Edited after initial review</div>
        </article>
    </section>

    <section class="insight-panel">
        <article class="panel-block">
            <div class="panel-title">QA Throughput Insight</div>
            <div id="throughput-note" class="mini-note">Only 20% of resolved tickets are rated. Focus this shift on oldest pending conversations first.</div>
            <div class="progress-track"><div id="throughput-progress" class="progress-fill"></div></div>
            <a class="insight-link" href="/QA/AllResolvedTickets">Open pending queue</a>
        </article>
        <article class="panel-block">
            <div class="panel-title">Quality Control Insight</div>
            <div id="quality-note" class="mini-note">Average quality is strong at 4.7/5. Keep monitoring low-scoring tickets and use edit-rating for calibration.</div>
            <a class="insight-link" href="/QA/RatedHistory">Review rated history</a>
        </article>
    </section>

    <section class="card trend-card">
        <div class="trend-head">
            <div>
                <h3 class="trend-title">Tickets per day (month trend)</h3>
                <div class="trend-sub">Daily ticket volume for this month with resolved vs QA-rated lines.</div>
            </div>
            <div class="trend-legend">
                <span class="legend-item"><span class="legend-dot resolved"></span>Total resolved</span>
                <span class="legend-item"><span class="legend-dot rated"></span>QA-rated</span>
            </div>
        </div>
        <div class="trend-wrap">
            <svg id="tickets-trend-chart" class="trend-svg" viewBox="0 0 960 260" role="img" aria-label="Monthly ticket trend chart"></svg>
        </div>
        <div class="trend-note-row">
            <span id="trend-peak" class="trend-note">Peak day: -</span>
            <span id="trend-quiet" class="trend-note">Quiet day: -</span>
        </div>
    </section>

    <section class="boards">
        <article class="card">
            <div class="card-head">
                <h3>Top performing agents</h3>
            </div>
            <div id="top-agent-list" class="agent-list">
                <div class="agent-item">
                    <div class="agent-left">
                        <span class="rank-pill">1</span>
                        <div>
                            <div class="agent-name">Alyson Cruz</div>
                            <div class="agent-sub">Resolved 43 tickets this week</div>
                        </div>
                    </div>
                    <span class="score-pill">4.9 / 5</span>
                </div>
                <div class="agent-item">
                    <div class="agent-left">
                        <span class="rank-pill">2</span>
                        <div>
                            <div class="agent-name">Miguel Dela Rosa</div>
                            <div class="agent-sub">Resolved 38 tickets this week</div>
                        </div>
                    </div>
                    <span class="score-pill">4.8 / 5</span>
                </div>
                <div class="agent-item">
                    <div class="agent-left">
                        <span class="rank-pill">3</span>
                        <div>
                            <div class="agent-name">Jenny Tan</div>
                            <div class="agent-sub">Resolved 35 tickets this week</div>
                        </div>
                    </div>
                    <span class="score-pill">4.7 / 5</span>
                </div>
                <div class="agent-item">
                    <div class="agent-left">
                        <span class="rank-pill">4</span>
                        <div>
                            <div class="agent-name">Arvin Santos</div>
                            <div class="agent-sub">Resolved 31 tickets this week</div>
                        </div>
                    </div>
                    <span class="score-pill">4.6 / 5</span>
                </div>
                <div class="agent-item">
                    <div class="agent-left">
                        <span class="rank-pill">5</span>
                        <div>
                            <div class="agent-name">Ramon Lee</div>
                            <div class="agent-sub">Resolved 30 tickets this week</div>
                        </div>
                    </div>
                    <span class="score-pill">4.6 / 5</span>
                </div>
            </div>
        </article>

        <article class="card">
            <div class="card-head">
                <h3>Resolved tickets awaiting QA</h3>
            </div>
            <div id="awaiting-ticket-list" class="ticket-list">
                <div class="ticket-item">
                    <div>
                        <div class="ticket-id">Ticket #10291 · Agent: Alyson Cruz · Customer: Mark Reyes</div>
                        <div class="ticket-sub">Resolved Apr 14, 2026 10:09 AM — awaiting QA rating</div>
                    </div>
                    <a class="ticket-btn" href="/QA/Rating/10291">Rate</a>
                </div>
                <div class="ticket-item">
                    <div>
                        <div class="ticket-id">Ticket #10290 · Agent: Miguel Dela Rosa · Customer: Nina Alvarez</div>
                        <div class="ticket-sub">Resolved Apr 14, 2026 09:34 AM — awaiting QA rating</div>
                    </div>
                    <a class="ticket-btn" href="/QA/Rating/10290">Rate</a>
                </div>
                <div class="ticket-item">
                    <div>
                        <div class="ticket-id">Ticket #10288 · Agent: Jenny Tan · Customer: Carlo Santos</div>
                        <div class="ticket-sub">Resolved Apr 14, 2026 07:58 AM — awaiting QA rating</div>
                    </div>
                    <a class="ticket-btn" href="/QA/Rating/10288">Rate</a>
                </div>
                <div class="ticket-item">
                    <div>
                        <div class="ticket-id">Ticket #10283 · Agent: Arvin Santos · Customer: Paolo Rivera</div>
                        <div class="ticket-sub">Resolved Apr 13, 2026 05:41 PM — awaiting QA rating</div>
                    </div>
                    <a class="ticket-btn" href="/QA/Rating/10283">Rate</a>
                </div>
            </div>
        </article>
    </section>
</section>

